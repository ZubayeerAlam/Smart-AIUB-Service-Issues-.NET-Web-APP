@model AssetIndexViewModel
@{
    ViewData["Title"] = "Assets";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="sc-page-header">
    <div>
        <h1>Asset registry</h1>
        <p>Equipment installed around campus, with its repair history.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add asset</a>
    }
</div>

<form method="get" class="sc-filter row g-2 align-items-end">
    <div class="col-12 col-lg">
        <label for="search" class="form-label">Search</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tag, name, serial or room" />
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <label asp-for="TypeId" class="form-label">Type</label>
        <select asp-for="TypeId" asp-items="Model.TypeOptions" class="form-select">
            <option value="">All types</option>
        </select>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <label asp-for="BuildingId" class="form-label">Building</label>
        <select asp-for="BuildingId" asp-items="Model.BuildingOptions" class="form-select">
            <option value="">All buildings</option>
        </select>
    </div>
    <div class="col-12 col-md-4 col-lg-2">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<AssetStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s.DisplayName()</option>
            }
        </select>
    </div>
    <div class="col-12 col-lg-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Filter</button>
        <a asp-action="Index" class="btn btn-light flex-fill">Reset</a>
    </div>
</form>

<div class="sc-table-card">
    @if (Model.Results.Items.Count == 0)
    {
        <div class="sc-empty">No assets match your filter.@(isAdmin ? " Add the first one with \"+ Add asset\"." : "")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Tag</th><th>Name</th><th>Type</th><th>Location</th><th>Status</th><th>Last maintenance</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Results.Items)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold text-decoration-none">@a.AssetTag</a></td>
                            <td>@a.Name</td>
                            <td>@a.TypeName</td>
                            <td class="text-nowrap">@a.BuildingName <span class="text-muted small">· Room @a.RoomNumber</span></td>
                            <td><span class="sc-badge @a.Status.BadgeClass()">@a.Status.DisplayName()</span></td>
                            <td class="small text-muted text-nowrap">@(a.LastMaintenanceAt?.ToDisplayDate() ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pagination" model="Model.Results" />
