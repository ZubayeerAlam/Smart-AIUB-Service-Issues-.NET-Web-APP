@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["FullWidth"] = true;
    ViewData["AuthHeading"] = "Join AIUB Smart Campus and help keep it running.";
}

<div class="container-fluid p-0">
    <div class="row g-0 sc-auth">
        <partial name="_AuthSide" />

        <div class="col-lg-7 d-flex align-items-center justify-content-center sc-auth-form">
            <div class="sc-auth-card">
                <h1 class="h2 mb-1">Create an account</h1>
                <p class="text-muted mb-4">For students and faculty. Support staff accounts are created by the administrator.</p>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Your full name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="UniversityId" class="form-label"></label>
                            <input asp-for="UniversityId" class="form-control" placeholder="e.g. 22-12345-1" />
                            <span asp-validation-for="UniversityId" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" asp-items="Model.RoleOptions" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select">
                            <option value="">-- Select department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <p class="form-text mb-4">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</p>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Create account</button>
                </form>

                <p class="mt-4 mb-0 text-center text-muted">
                    Already have an account? <a asp-action="Login" class="fw-semibold">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
