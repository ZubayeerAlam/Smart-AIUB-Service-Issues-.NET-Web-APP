<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b2545" />
    <title>@ViewData["Title"] - AIUB Smart Campus</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@*
    Pages set ViewData["FullWidth"] = true to draw edge-to-edge (hero, login).
    Other pages get a normal centred container.
*@
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark sc-navbar">
            <div class="container">
                <a class="sc-brand" asp-controller="Home" asp-action="Index">
                    <span class="sc-brand-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18" /><path d="M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <span class="sc-brand-text">AIUB Smart <span>Campus</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-md-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @* Role-specific links (Report Issue, Review Queue, Assets, ...) are added in later milestones. *@
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="sc-main">
        @if (ViewData["FullWidth"] is true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container sc-page">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="sc-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1">
            <span>&copy; 2026 <strong>AIUB Smart Campus</strong> · independent academic project</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
