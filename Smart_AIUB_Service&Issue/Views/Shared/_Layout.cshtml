<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b2545" />
    <title>@ViewData["Title"] - AIUB Smart Campus</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@*
    Pages set ViewData["FullWidth"] = true to draw edge-to-edge (hero, login).
    Other pages get a normal centred container.
*@
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sc-navbar">
            <div class="container">
                <a class="sc-brand" asp-controller="Home" asp-action="Index">
                    <span class="sc-brand-mark" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 21h18" /><path d="M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" />
                        </svg>
                    </span>
                    <span class="sc-brand-text">AIUB Smart <span>Campus</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-lg-4">
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            }
                        </li>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            @* Admins get one "Issues" menu so the navbar stays short. *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Issues</a>
                                <ul class="dropdown-menu sc-dropdown">
                                    <li><a class="dropdown-item fw-semibold" asp-controller="IssueReview" asp-action="Index">Review queue</a></li>
                                    <li><a class="dropdown-item" asp-controller="IssueReview" asp-action="All">All issues</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reports" asp-action="Index">Reports</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Issues" asp-action="Report">Report an issue</a></li>
                                    <li><a class="dropdown-item" asp-controller="Issues" asp-action="Index">My issues</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole(Roles.SupportStaff))
                            {
                                <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Issues" asp-action="Team" asp-route-scope="@TeamQueueScope.Mine">Team queue</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Assets" asp-action="Index">Assets</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Issues" asp-action="Report">Report issue</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Issues" asp-action="Index">My issues</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Issues" asp-action="Open">Open issues</a></li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Manage</a>
                                <ul class="dropdown-menu sc-dropdown">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Campus</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Buildings" asp-action="Index">Buildings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Index">Rooms</a></li>
                                    <li><a class="dropdown-item" asp-controller="Assets" asp-action="Index">Assets</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Lookups</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Departments" asp-action="Index">Departments</a></li>
                                    <li><a class="dropdown-item" asp-controller="IssueCategories" asp-action="Index">Issue categories</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupportTeams" asp-action="Index">Support teams</a></li>
                                    <li><a class="dropdown-item" asp-controller="AssetTypes" asp-action="Index">Asset types</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="sc-main">
        @if (ViewData["FullWidth"] is true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container sc-page">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        }
    </main>

    <footer class="sc-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-1">
            <span>&copy; 2026 <strong>AIUB Smart Campus</strong> · independent academic project</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
