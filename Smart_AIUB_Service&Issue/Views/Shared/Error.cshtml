@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@* Shown for unhandled exceptions outside Development. No technical details on purpose:
   they are written to the log instead, under the same request id. *@
<div class="sc-error">
    <div class="sc-error-code">500</div>
    <h1>Something went wrong</h1>
    <p class="text-muted">Sorry, an unexpected error happened. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">If it keeps happening, tell the administrator this code: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to home page</a>
</div>
