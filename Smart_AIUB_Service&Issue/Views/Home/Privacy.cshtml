@{
    ViewData["Title"] = "Privacy";
}

<div class="sc-form-wrap">
    <div class="sc-form-card">
        <h1 class="h3 mb-3">Privacy</h1>
        <p class="text-muted">
            AIUB Smart Campus is an independent academic project. It is not an official AIUB system and is not
            connected to any AIUB database.
        </p>

        <h2 class="h6 fw-bold mt-4">What we store</h2>
        <ul>
            <li>Your account: name, email, student/employee ID, department, role. Passwords are stored only as secure hashes.</li>
            <li>Issues you report, their status history, and comments.</li>
            <li>For support staff: the maintenance work they record.</li>
        </ul>

        <h2 class="h6 fw-bold mt-4">Who can see it</h2>
        <ul>
            <li>Your issues: you, the support team assigned to them, and administrators.</li>
            <li>The public "Open issues" list shows title, category, location and status, never your name.</li>
            <li>Internal staff notes are never shown to reporters.</li>
        </ul>

        <h2 class="h6 fw-bold mt-4">Cookies</h2>
        <p class="mb-0">
            We only use the cookies needed to keep you logged in and to protect forms against forgery (CSRF).
            No tracking or advertising cookies.
        </p>
    </div>
</div>
