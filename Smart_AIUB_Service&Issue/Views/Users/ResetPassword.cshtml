@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="sc-form-wrap">
    <a asp-action="Index" class="sc-back">&larr; Users</a>
    <div class="sc-form-card">
        <h1 class="h3 mb-1">Reset password</h1>
        <p class="text-muted mb-4">@Model.DisplayName</p>

        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="mb-3" role="alert"></div>

            <div class="row g-3 mb-1">
                <div class="col-sm-6">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <p class="form-text mb-4">
                At least 8 characters, with an uppercase letter, a lowercase letter and a digit.
                This also unlocks the account and signs the user out of other devices.
            </p>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Reset password</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
